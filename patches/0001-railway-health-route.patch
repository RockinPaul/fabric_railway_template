diff --git a/internal/server/health.go b/internal/server/health.go
new file mode 100644
index 0000000..03cf2c6
--- /dev/null
+++ b/internal/server/health.go
@@ -0,0 +1,16 @@
+package restapi
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+)
+
+// registerHealthRoute exposes an unauthenticated liveness endpoint. Platform
+// health checks are plain unauthenticated GETs, so this has to sit outside the
+// API-key middleware; it deliberately reports nothing but liveness.
+func registerHealthRoute(r *gin.Engine) {
+	r.GET("/health", func(c *gin.Context) {
+		c.JSON(http.StatusOK, gin.H{"status": "ok"})
+	})
+}
